{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fcitx5 Dynamic Themes theme config",
  "type": "object",
  "required": ["name", "mode", "variant", "palette"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "mode": { "enum": ["light", "dark"] },
    "variant": { "enum": ["rounded", "angular"] },
    "palette": { "$ref": "palette.schema.json" },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panel_radius": { "type": "number", "minimum": 0, "maximum": 20 },
        "highlight_radius": { "type": "number", "minimum": 0, "maximum": 20 },
        "panel_outline_width": { "type": "number", "minimum": 0, "maximum": 3 },
        "panel_inner_opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "highlight_inner_opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
