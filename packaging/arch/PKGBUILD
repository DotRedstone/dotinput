# Maintainer: DotRedstone
pkgname=dotinput-git
_pkgname=dotinput
pkgver=0.3.0.r0.g0000000
pkgrel=1
pkgdesc='Extensible Linux input method themes (development version)'
arch=('any')
url='https://github.com/DotRedstone/dotinput'
license=('MIT')
depends=('fcitx5' 'python')
optdepends=('noctalia: Noctalia dynamic color provider')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools')
provides=('dotinput')
conflicts=('dotinput')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/-/.r/;s/-/./g'
}

build() {
  cd "$_pkgname"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm755 scripts/install.sh "$pkgdir/usr/lib/$_pkgname/noctalia-setup"
  cp -r providers "$pkgdir/usr/share/$_pkgname/providers"
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/dotinput-noctalia-setup" <<'EOF'
#!/usr/bin/env bash
DOTINPUT_ROOT=/usr/share/$_pkgname exec /usr/lib/$_pkgname/noctalia-setup "$@"
EOF
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
}
