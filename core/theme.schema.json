{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fcitx5 Dynamic Themes theme config",
  "type": "object",
  "required": ["name", "mode", "variant", "palette"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "mode": { "enum": ["light", "dark"] },
    "variant": { "enum": ["rounded", "angular"] },
    "palette": { "$ref": "palette.schema.json" },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panel_radius": { "type": "number", "minimum": 0, "maximum": 26 },
        "highlight_radius": { "type": "number", "minimum": 0, "maximum": 25 },
        "panel_outline_width": { "type": "number", "minimum": 0, "maximum": 6 },
        "content_padding": { "type": "number", "minimum": 0, "maximum": 48 },
        "text_margin_horizontal": { "type": "number", "minimum": 0, "maximum": 24 },
        "text_margin_vertical": { "type": "number", "minimum": 0, "maximum": 24 },
        "text_margin_bottom": { "type": "number", "minimum": 0, "maximum": 24 },
        "panel_inner_opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "highlight_inner_opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "panel_slice_margin": { "type": "number", "minimum": 4, "maximum": 15 },
        "highlight_slice_margin_horizontal": { "type": "number", "minimum": 4, "maximum": 15 },
        "highlight_slice_margin_vertical": { "type": "number", "minimum": 4, "maximum": 15 },
        "full_width_highlight": { "type": "boolean" },
        "candidate_label_scale": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
        "candidate_comment_scale": { "type": "number", "minimum": 0.5, "maximum": 1.5 }
      }
    }
  }
}
